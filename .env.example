# Public pre-launch gate. Missing/invalid values also keep the gate enabled.
PUBLIC_GATE=true
# Generate locally with npm run gate:setup. Never use NEXT_PUBLIC_ for this.
# Must be a cryptographically random base64url secret, 43-128 characters.
PREVIEW_BYPASS_SECRET=

# Separate portfolio project only. Never enable on the public production project.
PORTFOLIO_MODE=false
# Generate with npm run portfolio:setup; never store a plaintext password.
PORTFOLIO_ACCESS_HASH=
PORTFOLIO_SESSION_SECRET=
# Hosted sign-in requires a shared Redis REST store; unavailable/missing = deny.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional absolute path for the development-only persisted rate-limit store.
PORTFOLIO_RATE_LIMIT_FILE=
